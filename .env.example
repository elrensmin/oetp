# OETP Development Environment
# Copy to .env and adjust for your setup

# === Edge Daemon ===
OETP_TENANT_ID=nta
OETP_EXAM_ID=jee-2027
OETP_DEVICE_ID=device-01
OETP_CENTER_ID=center-01
OETP_LEDGER_URL=http://localhost:8081
OETP_BEACON_URL=http://localhost:9090
OETP_LISTEN_ADDR=127.0.0.1:8080
OETP_DEVICE_KEY=./dev/device.key
OETP_DEVICE_X25519_KEY=./dev/device_x25519.key
OETP_CACHE_DIR=./dev/cache
OETP_QUEUE_DIR=./dev/queue
OETP_BEACON_PUBLIC_KEY=abababababababababababababababababababababababababababababababab
OETP_EXAM_SALT=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
OETP_SERVER_PEPPER=cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd
OETP_API_KEY=dev-api-key-12345678-with-enough-characters

# === Ledger ===
OETP_LEDGER_LISTEN_ADDR=0.0.0.0:8081
OETP_LEDGER_DB_PATH=./dev/ledger
OETP_SIGNING_KEY=abababababababababababababababababababababababababababababababab
OETP_ANCHOR_RPC_URL=http://localhost:8545

# === Beacon ===
OETP_BEACON_LISTEN_ADDR=0.0.0.0:9090
OETP_BEACON_SIGNING_KEY=abababababababababababababababababababababababababababababababab
OETP_EXAM_WINDOW_START=0
OETP_EXAM_WINDOW_END=18446744073709551615

# === Shared ===
OETP_TENANT_MASTER_KEY=abababababababababababababababababababababababababababababababab

# === Pilot Rate Limits (keyed by peer IP) ===
OETP_RATE_LIMIT_PER_SECOND=10
OETP_RATE_LIMIT_BURST=1000

# === Logging ===
RUST_LOG=info
